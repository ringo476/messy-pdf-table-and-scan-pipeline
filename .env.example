# Copy this file to .env and set your own values. Never commit .env.

# Required. The database password.
POSTGRES_PASSWORD=change-me

# Which address the web app listens on. 127.0.0.1 means this PC only.
# Use 0.0.0.0 to let other machines on your network connect. That traffic is plain HTTP,
# so only do this on a network you trust.
PDFPIPE_BIND=127.0.0.1
PDFPIPE_PORT=8000

# How many documents can be processed at the same time.
PDFPIPE_WORKERS=3

# The language model is off by default, and the pipeline costs nothing to run without it.
# When it is on, invoice text and page images of failed fields are sent to the provider you choose.
PDFPIPE_LLM_ENABLED=false

# "openai" (the default) or "anthropic". Only the chosen one is ever called.
PDFPIPE_LLM_PROVIDER=openai

# Your OpenAI key. Put it only in this .env file, which is never committed.
PDFPIPE_OPENAI_API_KEY=

# Optional. The cheap model that reads the failed fields, and a different one that gives a second opinion.
# Without a second model, a value for a field with no arithmetic to check it is only ever suggested to a person.
# PDFPIPE_OPENAI_FIRST_MODEL=gpt-4o-mini
# PDFPIPE_OPENAI_SECOND_MODEL=
# PDFPIPE_OPENAI_IMAGE_DETAIL=high

# Only if PDFPIPE_LLM_PROVIDER=anthropic.
PDFPIPE_ANTHROPIC_API_KEY=
